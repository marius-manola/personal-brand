{
  "manifest_version": 3,
  "name": "Local Content Studio — Gemini Companion",
  "version": "1.3.2",
  "description": "Connects a logged-in Gemini tab to Marius's localhost content studio for image generation.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.ggpht.com/*",
    "http://127.0.0.1:3002/*",
    "http://localhost:3002/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
