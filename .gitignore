# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only editorial content studio. The published blog remains tracked.
/app/content-studio/
/app/api/content-studio/
/lib/content-studio/
/.content-studio/
