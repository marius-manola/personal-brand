# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-content-studio-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Content Studio application and library source are tracked. Local runtime
# state remains ignored; only executable/support source below is synced.
/.content-studio/*
!/.content-studio/*.mjs
!/.content-studio/*.sh
!/.content-studio/*.plist
!/.content-studio/lib/
!/.content-studio/lib/**
!/.content-studio/chatgpt-extension/
!/.content-studio/chatgpt-extension/**
!/.content-studio/gemini-extension/
!/.content-studio/gemini-extension/**
